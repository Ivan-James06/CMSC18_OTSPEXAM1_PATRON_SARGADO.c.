/*
#include <stdio.h>

#define SIZE 10

int main(void)
{
    int matrix[SIZE][SIZE];
    int r, c, i, j, sum;

    printf("Enter rows and columns: ");
    scanf("%d %d", &r, &c);

    if (r < 1 || r > SIZE || c < 1 || c > SIZE) {
        printf("Invalid dimensions.\n");
        return 0;
    }

    printf("Enter the matrix:\n");
    for (i = 0; i < r; i++)
        for (j = 0; j < c; j++)
            scanf("%d", &matrix[i][j]);

    /* row sums */
    for (i = 0; i < r; i++) {
        sum = 0;
        for (j = 0; j < c; j++)
            sum += matrix[i][j];
        printf("Row %d sum: %d\n", i + 1, sum);
    }

    /* column sums */
    printf("Column sums:");
    for (j = 0; j < c; j++) {
        sum = 0;
        for (i = 0; i < r; i++)
            sum += matrix[i][j];
        printf(" %d", sum);
    }
    printf("\n");

    /* transpose: swap the roles of the loops */
    printf("Transpose:\n");
    for (j = 0; j < c; j++) {
        for (i = 0; i < r; i++) {
            if (i > 0) printf(" ");
            printf("%d", matrix[i][j]);
        }
        printf("\n");
    }
    return 0;
}
