#include <stdio.h>

int main(void)
{
    char msg[102];          /* 100 chars + newline + '\0' */
    int k, i;
    int firstOriginal;

    printf("Enter message: ");
    fgets(msg, sizeof(msg), stdin);

    /* remove the newline stored by fgets */
    for (i = 0; msg[i] != '\0'; i++) {
        if (msg[i] == '\n') {
            msg[i] = '\0';
            break;
        }
    }

    printf("Enter shift: ");
    scanf("%d", &k);

    firstOriginal = msg[0];

    for (i = 0; msg[i] != '\0'; i++) {
        if (msg[i] >= 'A' && msg[i] <= 'Z')
            msg[i] = (char)((msg[i] - 'A' + k) % 26 + 'A');
        else if (msg[i] >= 'a' && msg[i] <= 'z')
            msg[i] = (char)((msg[i] - 'a' + k) % 26 + 'a');
        /* other characters stay unchanged */
    }

    printf("First char ASCII (original): %d\n", firstOriginal);
    printf("Encrypted: %s\n", msg);
    printf("First char ASCII (encrypted): %d\n", msg[0]);
    return 0;
}
